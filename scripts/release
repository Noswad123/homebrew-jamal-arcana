#!/usr/bin/env python3
"""Release Jamal Arcana tools and update this Homebrew tap.

Default mode executes the release workflow. Pass --dry-run to preview planned
tags, pushes, formula updates, and tap changes without mutating anything.
"""

from __future__ import annotations

import argparse
import hashlib
import re
import shutil
import subprocess
import time
from dataclasses import dataclass
from pathlib import Path
from urllib.error import URLError
from urllib.request import urlopen


SEMVER_RE = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)$")
MIND_WEAVER_CASK_ALIASES = {"mind-weaver", "mindweaver", "mind-weaver-swift"}
MIND_WEAVER_RELEASE_REPO = "Noswad123/mind-weaver-swift"


@dataclass(frozen=True)
class Formula:
    stem: str
    path: Path
    repo_slug: str
    repo_name: str
    current_version: str


def log(message: str) -> None:
    print(message, flush=True)


def run(
    args: list[str],
    *,
    cwd: Path | None = None,
    capture: bool = False,
    dry_run: bool = False,
    mutates: bool = False,
) -> str:
    display_cwd = f" ({cwd})" if cwd else ""
    prefix = "DRY-RUN " if dry_run and mutates else ""
    log(f"{prefix}$ {' '.join(args)}{display_cwd}")

    if dry_run and mutates:
        return ""

    completed = subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    return completed.stdout.strip() if capture else ""


def git(repo: Path, args: list[str], *, capture: bool = False, dry_run: bool = False, mutates: bool = False) -> str:
    return run(["git", *args], cwd=repo, capture=capture, dry_run=dry_run, mutates=mutates)


def parse_version(version: str) -> tuple[int, int, int]:
    match = SEMVER_RE.match(version)
    if not match:
        raise ValueError(f"unsupported version: {version}")
    return tuple(int(part) for part in match.groups())  # type: ignore[return-value]


def bump_version(version: str, part: str) -> str:
    major, minor, patch = parse_version(version)
    if part == "major":
        return f"{major + 1}.0.0"
    if part == "minor":
        return f"{major}.{minor + 1}.0"
    if part == "patch":
        return f"{major}.{minor}.{patch + 1}"
    raise ValueError(f"unsupported bump part: {part}")


def latest_repo_version(repo: Path) -> str | None:
    tags = git(repo, ["tag", "--list", "v[0-9]*.[0-9]*.[0-9]*", "--sort=-v:refname"], capture=True)
    for tag in tags.splitlines():
        match = SEMVER_RE.match(tag.strip())
        if match:
            return ".".join(match.groups())
    return None


def formula_repo_slug(text: str) -> str:
    for pattern in (
        r'homepage\s+"https://github\.com/([^/"\s]+/[^/"\s]+)"',
        r'head\s+"https://github\.com/([^/"\s]+/[^"\s]+?)(?:\.git)?"',
        r'url\s+"https://github\.com/([^/"\s]+/[^/"\s]+)(?:/archive|\.git)',
    ):
        match = re.search(pattern, text)
        if match:
            return match.group(1).removesuffix(".git")
    raise ValueError("could not infer GitHub repo from formula")


def formula_version(text: str, repo: Path | None) -> str:
    for pattern in (
        r'archive/refs/tags/v?(\d+\.\d+\.\d+)\.tar\.gz',
        r'version\s+"(\d+\.\d+\.\d+)(?:-[^"]+)?"',
    ):
        match = re.search(pattern, text)
        if match:
            return match.group(1)

    if repo and repo.is_dir():
        version = latest_repo_version(repo)
        if version:
            return version

    return "0.0.0"


def load_formula(path: Path, projects_dir: Path) -> Formula:
    text = path.read_text()
    repo_slug = formula_repo_slug(text)
    repo_name = repo_slug.split("/", 1)[1]
    repo = projects_dir / repo_name
    return Formula(
        stem=path.stem,
        path=path,
        repo_slug=repo_slug,
        repo_name=repo_name,
        current_version=formula_version(text, repo if repo.is_dir() else None),
    )


def selected_formulae(formulae: list[Formula], requested: list[str]) -> list[Formula]:
    if not requested:
        return formulae

    selected: list[Formula] = []
    wanted = {item.strip().lower() for raw in requested for item in raw.split(",") if item.strip()}
    matched: set[str] = set()

    for formula in formulae:
        aliases = {formula.stem.lower(), formula.repo_name.lower()}
        if aliases & wanted:
            selected.append(formula)
            matched.update(aliases & wanted)

    missing = wanted - matched
    if missing:
        raise SystemExit(f"unknown tool(s): {', '.join(sorted(missing))}")
    return selected


def ensure_clean(repo: Path, label: str, *, allow_dirty: bool) -> None:
    status = git(repo, ["status", "--porcelain"], capture=True)
    if not status:
        return
    if allow_dirty:
        log(f"WARNING: {label} has uncommitted changes; continuing because --allow-dirty was set")
        return
    raise SystemExit(f"{label} has uncommitted changes; commit/stash them or use --allow-dirty\n{status}")


def tag_exists(repo: Path, remote: str, tag: str) -> bool:
    local = git(repo, ["tag", "--list", tag], capture=True)
    remote_ref = git(repo, ["ls-remote", "--tags", remote, f"refs/tags/{tag}"], capture=True)
    return bool(local.strip() or remote_ref.strip())


def run_project_tests(repo: Path, *, dry_run: bool) -> None:
    smoke_test = repo / "scripts" / "smoke-test"
    if smoke_test.exists():
        run([str(smoke_test)], cwd=repo, dry_run=dry_run, mutates=False)
    else:
        log(f"No scripts/smoke-test found in {repo}; skipping project tests")


def download_sha256(url: str, *, retries: int = 12) -> str:
    last_error: Exception | None = None
    for attempt in range(1, retries + 1):
        try:
            with urlopen(url, timeout=30) as response:
                data = response.read()
            return hashlib.sha256(data).hexdigest()
        except URLError as error:
            last_error = error
            log(f"Archive not available yet ({attempt}/{retries}); retrying...")
            time.sleep(2)
    raise RuntimeError(f"failed to download {url}: {last_error}")


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def cask_version(text: str) -> str:
    match = re.search(r'^\s*version\s+"(\d+\.\d+\.\d+)"', text, flags=re.MULTILINE)
    if not match:
        raise ValueError("could not infer cask version")
    return match.group(1)


def infer_mind_weaver_version(input_path: Path, cask_path: Path, explicit_version: str | None) -> str:
    if explicit_version:
        if not SEMVER_RE.match(explicit_version):
            raise SystemExit(f"invalid MindWeaver version: {explicit_version}")
        return explicit_version.removeprefix("v")

    match = re.search(r"MindWeaver[-_ ]v?(\d+\.\d+\.\d+)\.zip$", input_path.name)
    if match:
        return match.group(1)

    return cask_version(cask_path.read_text())


def prepare_mind_weaver_zip(input_path: Path, output_path: Path, *, dry_run: bool) -> Path:
    if not input_path.exists():
        raise SystemExit(f"MindWeaver app artifact not found: {input_path}")

    if input_path.suffix.lower() == ".zip":
        return input_path

    if input_path.suffix.lower() != ".app":
        raise SystemExit("--mind-weaver-app must point to MindWeaver.app or a MindWeaver-<version>.zip file")

    if input_path.name != "MindWeaver.app":
        log(f"WARNING: expected app bundle named MindWeaver.app, got {input_path.name}")

    log(f"Creating {output_path} from {input_path}")
    if dry_run:
        log(f"DRY-RUN would run: ditto -c -k --keepParent {input_path} {output_path}")
        return output_path

    output_path.parent.mkdir(parents=True, exist_ok=True)
    if output_path.exists():
        output_path.unlink()
    run(["ditto", "-c", "-k", "--keepParent", str(input_path), str(output_path)], mutates=True)
    return output_path


def update_mind_weaver_cask(cask_path: Path, *, version: str, sha256: str, dry_run: bool) -> None:
    text = cask_path.read_text()
    text = re.sub(r'^\s*version\s+"[^"]+"', f'  version "{version}"', text, count=1, flags=re.MULTILINE)
    text = re.sub(r'^\s*sha256\s+(:no_check|"[0-9a-fA-F]+")', f'  sha256 "{sha256}"', text, count=1, flags=re.MULTILINE)

    if dry_run:
        log(f"DRY-RUN would update {cask_path} -> v{version} ({sha256})")
        return

    cask_path.write_text(text)
    log(f"Updated {cask_path} -> v{version}")


def gh_release_exists(tag: str, *, repo: str) -> bool:
    completed = subprocess.run(
        ["gh", "release", "view", tag, "--repo", repo],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return completed.returncode == 0


def upload_mind_weaver_app(zip_path: Path, *, version: str, repo: str, create_release: bool, dry_run: bool) -> None:
    tag = f"v{version}"
    if not shutil.which("gh"):
        raise SystemExit("gh not found; install GitHub CLI or omit --upload-mind-weaver-app")

    if dry_run:
        if create_release:
            log(
                "DRY-RUN would ensure GitHub release exists with:\n"
                f"  gh release create {tag} --repo {repo} --title 'MindWeaver {tag}' --notes 'MindWeaver {tag} macOS release'"
            )
        log(
            "DRY-RUN would upload with:\n"
            f"  gh release upload {tag} {zip_path} --repo {repo} --clobber"
        )
        return

    if not gh_release_exists(tag, repo=repo):
        if not create_release:
            raise SystemExit(
                f"GitHub release {repo} {tag} not found. Create it first or rerun with --create-mind-weaver-release."
            )
        gh_mutation(
            [
                "release",
                "create",
                tag,
                "--repo",
                repo,
                "--title",
                f"MindWeaver {tag}",
                "--notes",
                f"MindWeaver {tag} macOS release",
            ],
            action="create GitHub release",
        )

    gh_mutation(
        ["release", "upload", tag, str(zip_path), "--repo", repo, "--clobber"],
        action="upload MindWeaver release artifact",
    )


def gh_mutation(args: list[str], *, action: str) -> None:
    command = ["gh", *args]
    log(f"$ {' '.join(command)}")
    completed = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if completed.stdout.strip():
        log(completed.stdout.strip())
    if completed.returncode == 0:
        return

    stderr = completed.stderr.strip()
    raise SystemExit(
        f"Failed to {action}.\n"
        f"{stderr}\n\n"
        "If GitHub CLI reports a missing scope, refresh auth with:\n"
        "  gh auth refresh -h github.com -s workflow\n"
        "Then rerun the release command."
    )


def release_mind_weaver_cask(
    *,
    tap_dir: Path,
    input_path: Path,
    version: str | None,
    output_zip: Path | None,
    upload: bool,
    create_release: bool,
    release_repo: str,
    dry_run: bool,
) -> Path:
    cask_path = tap_dir / "Casks" / "mind-weaver.rb"
    if not cask_path.exists():
        raise SystemExit(f"MindWeaver cask not found: {cask_path}")

    resolved_version = infer_mind_weaver_version(input_path, cask_path, version)
    zip_path = output_zip or tap_dir / "dist" / f"MindWeaver-{resolved_version}.zip"

    log(f"\n==> mind-weaver cask: v{resolved_version}")
    artifact = prepare_mind_weaver_zip(input_path, zip_path, dry_run=dry_run)

    expected_name = f"MindWeaver-{resolved_version}.zip"
    if artifact.name != expected_name:
        log(f"WARNING: cask URL expects {expected_name}; artifact is named {artifact.name}")

    if dry_run and not artifact.exists():
        sha256 = "0" * 64
        log(f"DRY-RUN would compute sha256 for {artifact}")
    else:
        sha256 = file_sha256(artifact)

    if upload:
        upload_mind_weaver_app(
            artifact,
            version=resolved_version,
            repo=release_repo,
            create_release=create_release,
            dry_run=dry_run,
        )
    else:
        log(
            "Upload manually after creating the GitHub release with:\n"
            f"  gh release upload v{resolved_version} {artifact} --repo {release_repo} --clobber"
        )

    update_mind_weaver_cask(cask_path, version=resolved_version, sha256=sha256, dry_run=dry_run)
    return cask_path


def update_formula_file(formula: Formula, tag: str, sha256: str, *, dry_run: bool) -> None:
    text = formula.path.read_text()
    archive_url = f"https://github.com/{formula.repo_slug}/archive/refs/tags/{tag}.tar.gz"
    head_url = f"https://github.com/{formula.repo_slug}.git"

    lines = text.splitlines()
    updated: list[str] = []
    saw_url = False
    saw_sha = False
    saw_head = "head " in text

    for line in lines:
        stripped = line.strip()
        indent = line[: len(line) - len(line.lstrip())]

        if stripped.startswith("url "):
            updated.append(f'{indent}url "{archive_url}"')
            saw_url = True
            continue

        if stripped.startswith("sha256 "):
            updated.append(f'{indent}sha256 "{sha256}"')
            saw_sha = True
            continue

        if stripped.startswith("version "):
            continue

        updated.append(line)

        if saw_url and not saw_sha and stripped.startswith("license "):
            # Handles formulae that used a git branch URL and therefore had no sha256.
            updated.insert(len(updated) - 1, f'{indent}sha256 "{sha256}"')
            saw_sha = True

        if not saw_head and stripped.startswith("license "):
            updated.append(f'{indent}head "{head_url}", branch: "main"')
            saw_head = True

    new_text = "\n".join(updated) + "\n"
    if dry_run:
        log(f"DRY-RUN would update {formula.path} -> {tag} ({sha256})")
        return
    formula.path.write_text(new_text)
    log(f"Updated {formula.path} -> {tag}")


def release_formula(
    formula: Formula,
    *,
    projects_dir: Path,
    part: str,
    remote: str,
    dry_run: bool,
    push: bool,
    allow_dirty: bool,
    skip_tests: bool,
) -> str | None:
    repo = projects_dir / formula.repo_name
    if not repo.is_dir():
        raise SystemExit(f"local repo not found for {formula.stem}: {repo}")

    next_version = bump_version(formula.current_version, part)
    tag = f"v{next_version}"

    log(f"\n==> {formula.stem}: {formula.current_version} -> {next_version}")
    ensure_clean(repo, formula.repo_name, allow_dirty=allow_dirty)

    if not dry_run:
        git(repo, ["fetch", "--tags", remote], dry_run=dry_run, mutates=True)

    if tag_exists(repo, remote, tag):
        raise SystemExit(f"tag already exists for {formula.stem}: {tag}")

    if not skip_tests:
        run_project_tests(repo, dry_run=dry_run)

    git(repo, ["tag", "-a", tag, "-m", f"Release {tag}"], dry_run=dry_run, mutates=True)
    if push:
        git(repo, ["push", remote, tag], dry_run=dry_run, mutates=True)
    else:
        log(f"Skipping tag push for {formula.stem} because --no-push was set")
        if not dry_run:
            log("Skipping formula update because GitHub archive sha256 requires the tag to be pushed")
            return None

    archive_url = f"https://github.com/{formula.repo_slug}/archive/refs/tags/{tag}.tar.gz"
    if dry_run:
        log(f"DRY-RUN would download {archive_url} and compute sha256")
        return tag

    sha256 = download_sha256(archive_url)
    update_formula_file(formula, tag, sha256, dry_run=dry_run)
    return tag


def commit_tap(tap_dir: Path, updated_paths: list[Path], *, dry_run: bool, push: bool, remote: str) -> None:
    if not updated_paths:
        return

    rel_paths = [str(path.relative_to(tap_dir)) for path in updated_paths]
    git(tap_dir, ["diff", "--", *rel_paths], dry_run=False, mutates=False)
    git(tap_dir, ["add", *rel_paths], dry_run=dry_run, mutates=True)
    git(tap_dir, ["commit", "-m", "Update Jamal Arcana releases"], dry_run=dry_run, mutates=True)
    if push:
        git(tap_dir, ["push", remote, "HEAD"], dry_run=dry_run, mutates=True)
    else:
        log("Skipping tap push because --no-push was set")


def infer_tap_name(tap_dir: Path, remote: str) -> str | None:
    remote_url = git(tap_dir, ["remote", "get-url", remote], capture=True)
    match = re.search(r"github\.com[:/]([^/]+)/homebrew-([^/.]+)(?:\.git)?$", remote_url)
    if not match:
        return None
    owner, tap = match.groups()
    return f"{owner.lower()}/{tap}"


def update_local_brew_tap(tap_name: str, *, dry_run: bool) -> None:
    if not shutil.which("brew"):
        log("brew not found; skipping local Homebrew tap sync")
        return

    tap_repo = run(["brew", "--repo", tap_name], capture=True, dry_run=dry_run, mutates=False)
    if not tap_repo:
        log(f"Homebrew tap {tap_name} is not installed locally; skipping local tap sync")
        return

    git(Path(tap_repo), ["pull", "--ff-only"], dry_run=dry_run, mutates=True)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Release Jamal Arcana tools and update Homebrew formulae/casks")
    parser.add_argument("-p", "--part", choices=("patch", "minor", "major"), default="patch", help="version part to bump; default: patch")
    parser.add_argument("-t", "--tool", action="append", default=[], help="formula/tool to release; may be repeated or comma-separated; default: all")
    parser.add_argument("--projects-dir", type=Path, default=None, help="directory containing local tool repos; default: parent of tap repo")
    parser.add_argument("--remote", default="origin", help="git remote for tool repos and tap; default: origin")
    parser.add_argument("--execute", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--dry-run", action="store_true", help="preview actions without creating tags, pushing, updating formulae, or committing")
    parser.add_argument("--no-push", action="store_true", help="create local tags but do not push tags or tap; formula updates are skipped in execute mode")
    parser.add_argument("--no-tap-commit", action="store_true", help="update formula files but do not commit/push the tap")
    parser.add_argument("--no-brew-update", action="store_true", help="do not sync Homebrew's local tap clone after pushing the tap")
    parser.add_argument("--allow-dirty", action="store_true", help="allow releasing repos with uncommitted changes")
    parser.add_argument("--skip-tests", action="store_true", help="skip scripts/smoke-test checks")
    parser.add_argument("--mind-weaver-app", type=Path, default=None, help="path to exported MindWeaver.app or MindWeaver-<version>.zip; updates the mind-weaver cask")
    parser.add_argument("--mind-weaver-version", default=None, help="MindWeaver app version for cask update; default: ZIP filename or current cask version")
    parser.add_argument("--mind-weaver-zip-output", type=Path, default=None, help="output ZIP path when --mind-weaver-app points to a .app bundle; default: dist/MindWeaver-<version>.zip")
    parser.add_argument("--upload-mind-weaver-app", action="store_true", help="upload the MindWeaver ZIP to an existing GitHub release with gh release upload --clobber")
    parser.add_argument("--create-mind-weaver-release", action="store_true", help="create the GitHub release if missing before uploading the MindWeaver ZIP")
    parser.add_argument("--mind-weaver-release-repo", default=MIND_WEAVER_RELEASE_REPO, help=f"GitHub release repo for MindWeaver app; default: {MIND_WEAVER_RELEASE_REPO}")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    tap_dir = Path(__file__).resolve().parents[1]
    formula_dir = tap_dir / "Formula"
    projects_dir = args.projects_dir or tap_dir.parent
    dry_run = args.dry_run
    push = not args.no_push

    formulae = [load_formula(path, projects_dir) for path in sorted(formula_dir.glob("*.rb"))]
    requested_cask = False
    formula_tools = args.tool
    if args.mind_weaver_app:
        requested = [item.strip().lower() for raw in args.tool for item in raw.split(",") if item.strip()]
        requested_cask = not requested or any(item in MIND_WEAVER_CASK_ALIASES for item in requested)
        formula_tools = [item for item in requested if item not in MIND_WEAVER_CASK_ALIASES]

    targets = selected_formulae(formulae, formula_tools) if formula_tools or not args.mind_weaver_app else []
    if not targets and not requested_cask:
        raise SystemExit("no formulae or casks selected")

    log(f"Mode: {'dry-run' if dry_run else 'execute'}")
    log(f"Version bump: {args.part}")
    log(f"Projects dir: {projects_dir}")
    target_labels = [formula.stem for formula in targets]
    if requested_cask:
        target_labels.append("mind-weaver cask")
    log(f"Targets: {', '.join(target_labels)}")

    if not dry_run:
        ensure_clean(tap_dir, "homebrew-jamal-arcana", allow_dirty=args.allow_dirty)

    updated_paths: list[Path] = []
    if requested_cask and args.mind_weaver_app:
        updated_paths.append(
            release_mind_weaver_cask(
                tap_dir=tap_dir,
                input_path=args.mind_weaver_app,
                version=args.mind_weaver_version,
                output_zip=args.mind_weaver_zip_output,
                upload=args.upload_mind_weaver_app,
                create_release=args.create_mind_weaver_release,
                release_repo=args.mind_weaver_release_repo,
                dry_run=dry_run,
            )
        )

    for formula in targets:
        released_tag = release_formula(
            formula,
            projects_dir=projects_dir,
            part=args.part,
            remote=args.remote,
            dry_run=dry_run,
            push=push,
            allow_dirty=args.allow_dirty,
            skip_tests=args.skip_tests,
        )
        if released_tag is not None:
            updated_paths.append(formula.path)

    if not dry_run and not args.no_tap_commit:
        commit_tap(tap_dir, updated_paths, dry_run=dry_run, push=push, remote=args.remote)
        if push and not args.no_brew_update:
            tap_name = infer_tap_name(tap_dir, args.remote)
            if tap_name:
                update_local_brew_tap(tap_name, dry_run=dry_run)
            else:
                log("Could not infer Homebrew tap name; skipping local tap sync")
    elif args.no_tap_commit:
        log("Leaving formula changes uncommitted because --no-tap-commit was set")

    log("Done")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
